# ============================================================================
#  BarBus — пример конфигурации окружения
#  Скопируйте в .env (он в .gitignore) и заполните. `npm start` = прод-режим.
#  Для разработки используйте `npm run dev:local` (NODE_ENV=development).
# ============================================================================


# ─── 🔒 БЕЗОПАСНОСТЬ: ОБЯЗАТЕЛЬНО в проде ───────────────────────────────────
#  Из аудита (Wave 44). Без правильных значений сервер стартует, но выводит
#  [security]-предупреждения и остаётся уязвим к соответствующим сценариям.

# Прод-режим. Отключает dev-эндпоинт локального входа админа (/admin-local-login)
# и включает fail-closed проверки. ОБЯЗАТЕЛЬНО "production" на боевом сервере.
NODE_ENV=production

# Требовать проверенную Telegram initData на пользовательских записях
# (обращения/контакты). Без true в проде — принимаются анонимные заявки (спам).
# Ставьте false ТОЛЬКО если анонимный сбор с сайта — намеренный сценарий.
REQUIRE_TELEGRAM_AUTH=true

# Вы за обратным прокси (nginx/caddy/traefik)? Тогда true + список IP прокси,
# иначе rate-limit общий на всех клиентов (self-DoS), а X-Forwarded-For слеп.
TRUST_PROXY=true
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Ключ доступа к админ-панели по заголовку x-admin-key. Минимум 16 случайных
# символов (короткий/"change-me" молча отключается). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=CHANGE_ME_generate_a_32_char_random_key

# Секрет для подписи ссылок на приватные вложения. Если не задан — генерируется
# случайно при старте, и все выданные ссылки ломаются при каждом рестарте.
# В проде задайте фиксированный. Сгенерировать так же, как ADMIN_KEY.
FILE_ACCESS_SECRET=CHANGE_ME_generate_a_64_char_random_hex

# НЕ включать в проде: пускает админ-ключ в URL (?key=…) → утечка в логи/Referer.
ALLOW_ADMIN_QUERY_KEY=false
# НЕ включать без причины: разрешает подмену роли через заголовок x-admin-role.
ALLOW_ADMIN_ROLE_OVERRIDE=false


# ─── Telegram-бот и Mini App ────────────────────────────────────────────────

# Токен бота от @BotFather. Нужен для проверки initData и работы бота.
BOT_TOKEN=123456789:CHANGE_ME_bot_token_from_BotFather
# Юзернейм бота без @ (для deep-link'ов).
BOT_USERNAME=your_bus_bot
# Публичный URL, где открывается Mini App (для кнопок/ссылок).
WEBAPP_URL=https://your-domain.example
# Telegram ID владельцев-администраторов (CSV). Только они могут само-регистрировать
# админов через чат. Узнать свой ID можно у @userinfobot.
ADMIN_IDS=
# ID чата для служебных уведомлений бота (опционально).
ADMIN_CHAT_ID=


# ─── Сервер и данные ────────────────────────────────────────────────────────

# Порт HTTP-сервера.
PORT=3000
# Часовой пояс (расписания, будильники). По умолчанию Europe/Minsk.
TZ=Europe/Minsk
# Путь к файлу БД sqlite. По умолчанию — внутри проекта (data/…). Для прода
# лучше вынести на постоянный том вне репозитория.
DATABASE_PATH=
# Директория приватных загрузок (вложения обращений). По умолчанию data/uploads.
PRIVATE_UPLOAD_DIR=
# Название города в текстах.
CITY_NAME=Барановичи


# ─── Интеграции ─────────────────────────────────────────────────────────────

# Ключ Яндекс.Карт (публично отдаётся клиенту — это by design). ОБЯЗАТЕЛЬНО
# ограничьте его по домену в консоли Яндекса, иначе им воспользуются со стороны.
YANDEX_MAPS_API_KEY=


# ─── Расширенная настройка (обычно менять не нужно) ─────────────────────────
#  Значения по умолчанию. Раскомментируйте только при необходимости.
#  ВНИМАНИЕ: не пишите комментарий в одной строке со значением — парсер .env
#  не срезает его (хвост попадёт в значение). Комментарий — отдельной строкой.

# Срок жизни проверенной initData, мс (по умолчанию 6 часов). Меньше = меньше
# окно replay при утечке.
#TELEGRAM_INIT_DATA_TTL_MS=21600000

# TTL подписанных ссылок на вложения, мс (по умолчанию 15 минут).
#APPEAL_FILE_TTL_MS=900000

# Порог синхронного gzip, байт (по умолчанию 2 МБ): ответы больше — без сжатия.
#TEXT_COMPRESS_MAX_BYTES=2097152

# Лимит публичных read-запросов и окно, мс (по умолчанию 1200 / 60000).
#PUBLIC_READ_RATE_LIMIT=1200
#PUBLIC_READ_RATE_WINDOW_MS=60000

# Макс. попыток ввода админ-кода в чате перед блокировкой (по умолчанию 5).
#ADMIN_ACCESS_MAX_ATTEMPTS=5

# Бот: long-polling включён по умолчанию. true — выключить polling.
#DISABLE_TELEGRAM_POLLING=false

# Ежедневная рассылка табеля и время ЧЧ:ММ (по умолчанию вкл, 18:00).
#DUTY_ROSTER_DAILY_ENABLED=true
#DUTY_ROSTER_DAILY_SEND_TIME=18:00

# Прогрев публичного кэша при старте (по умолчанию true).
#WARM_PUBLIC_CACHE_ON_START=true

# Fallback на другой порт при занятости (только вне прода, по умолчанию true/25).
#PORT_FALLBACK_ENABLED=true
#PORT_FALLBACK_ATTEMPTS=25

# Тайминги сервера, мс.
#SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
#SERVER_HEADERS_TIMEOUT_MS=66000
#SERVER_REQUEST_TIMEOUT_MS=0

# Кэш статики, сек.
#STATIC_ASSET_MAX_AGE_SECONDS=3600
#IMMUTABLE_STATIC_MAX_AGE_SECONDS=31536000
